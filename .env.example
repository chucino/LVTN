# Server Configuration
PORT=3000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Database (MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27017/nextcode_db

# JWT Secrets & Expiration
JWT_ACCESS_SECRET=your_super_secret_access_jwt_key_32_chars_min
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=your_super_secret_refresh_jwt_key_32_chars_min
JWT_REFRESH_TTL=7d

# Gmail SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
MAIL_FROM="NextCode Education" <your_email@gmail.com>

# OTP Configuration
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# Rate Limiting (Throttler)
THROTTLE_TTL=60000
THROTTLE_LIMIT=20
